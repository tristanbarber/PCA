* -------- PARALLEL TREE --------
.subckt rctree_parallel 1 100

X1 1 11 rc1000
X2 1 21 rc1000
X3 1 31 rc1000
X4 1 41 rc1000
X5 1 51 rc1000
X6 1 61 rc1000
X7 1 71 rc1000
X8 1 81 rc1000

.ends

.tran 0.1u 1
.print tran V(2)
.end